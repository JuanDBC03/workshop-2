# ============================================================
# WORKSHOP 2 - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Airflow Core Settings
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.8-python3.12
AIRFLOW_UID=50000
_PIP_ADDITIONAL_REQUIREMENTS=great-expectations>=1.0.0 psycopg2-binary sqlalchemy pandas pyarrow pendulum

# PostgreSQL Database Credentials
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Operational Source Database (Grammys)
POSTGRES_SOURCE_DB=grammy_source

# Analytical Target Database (Data Warehouse)
POSTGRES_DW_DB=music_dw

# Airflow Internal Metadata Database
AIRFLOW_DB=airflow
